<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NBenchmark.Tests</RootNamespace>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NBenchmark\NBenchmark.csproj"/>
    <ProjectReference Include="..\NBenchmark.Tests.ErrorFixtures\NBenchmark.Tests.ErrorFixtures.csproj"/>

    <!--
      The isolation fixture is a standalone executable that real-child-process tests launch via
      `dotnet exec`. ReferenceOutputAssembly=false because we never compile against it - we only
      need it built, and we need its own output directory (which has its runtimeconfig.json)
      rather than a copy of the dll next to the test assembly.
    -->
    <ProjectReference Include="..\NBenchmark.Tests.IsolationFixture\NBenchmark.Tests.IsolationFixture.csproj"
                     ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      Baked in at build time so the tests never have to guess at relative bin paths. Both
      projects multi-target the same TFMs and build under the same configuration, so the test's
      own $(Configuration)/$(TargetFramework) always name the matching fixture output.
    -->
    <AssemblyMetadata Include="IsolationFixtureDirectory"
                      Value="$(MSBuildThisFileDirectory)..\NBenchmark.Tests.IsolationFixture\bin\$(Configuration)\$(TargetFramework)\"/>
  </ItemGroup>

</Project>