<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NBenchmark.Integration.MSTest.Tests</RootNamespace>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>

    <!--
      Deploys the measurement worker, so these tests prove a performance test really is measured
      out of process. Without it they would still pass - via the labelled in-host fallback - and a
      silent fallback looks identical to success.
    -->
    <NBenchmarkUseWorker>true</NBenchmarkUseWorker>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="MSTest"/>
    <PackageReference Include="MSTest.TestFramework"/>
    <PackageReference Include="MSTest.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NBenchmark.Integration.Abstractions\NBenchmark.Integration.Abstractions.csproj"/>
    <ProjectReference Include="..\..\src\NBenchmark.Integration.MSTest\NBenchmark.Integration.MSTest.csproj"/>
    <ProjectReference Include="..\..\src\NBenchmark\NBenchmark.csproj"/>
  </ItemGroup>

</Project>
