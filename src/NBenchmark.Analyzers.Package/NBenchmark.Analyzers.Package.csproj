<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <RootNamespace>NBenchmark.Analyzers.Package</RootNamespace>
    <LangVersion>12</LangVersion>

    <!-- Package Configuration -->
    <PackageId>NBenchmark.Analyzers</PackageId>
    <Title>NBenchmark Analyzers</Title>
    <Description>NBenchmark analyzers and code fixes for detecting and resolving common benchmark configuration issues at compile time</Description>
    <PackageTags>analyzers;roslyn;nbenchmark;codefixes;diagnostics;benchmark</PackageTags>

    <!-- Analyzer Configuration -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- Project references for analyzer and code fixes -->
  <ItemGroup>
    <ProjectReference Include="..\NBenchmark.Analyzers\NBenchmark.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\NBenchmark.CodeFixes\NBenchmark.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!-- Custom target to include analyzer assemblies in the package -->
  <Target Name="IncludeAnalyzersInPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="..\NBenchmark.Analyzers\bin\$(Configuration)\netstandard2.0\NBenchmark.Analyzers.dll">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="..\NBenchmark.CodeFixes\bin\$(Configuration)\netstandard2.0\NBenchmark.CodeFixes.dll">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <!-- Hook into the pack process -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeAnalyzersInPackage</TargetsForTfmSpecificContentInPackage>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- Shared package metadata: authors, repository URL, source link, symbols, XML docs. -->
  <Import Project="../../Release.props"/>

  <PropertyGroup>
    <!-- After the import, because Release.props turns symbols on for a normal library. There is
         no build output here to symbolicate: the analyzer assemblies arrive as content. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

</Project>
