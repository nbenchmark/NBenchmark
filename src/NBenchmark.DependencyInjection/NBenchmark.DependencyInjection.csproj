<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NBenchmark.DependencyInjection</RootNamespace>

    <IsPackable>true</IsPackable>
    <IsShippingLibrary>true</IsShippingLibrary>

    <PackageId>NBenchmark.DependencyInjection</PackageId>
    <Description>Resolves benchmark classes from an IServiceProvider so they can have constructor dependencies.</Description>
    <PackageTags>benchmark;performance;dependency-injection;di</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBenchmark\NBenchmark.csproj"/>
  </ItemGroup>

  <!-- Shared package metadata: authors, repository URL, source link, symbols, XML docs. -->
  <Import Project="../../Release.props"/>

</Project>
