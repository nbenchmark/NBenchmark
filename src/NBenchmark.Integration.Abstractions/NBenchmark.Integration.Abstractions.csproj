<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NBenchmark.Integration.Abstractions</RootNamespace>

    <IsPackable>true</IsPackable>
    <IsShippingLibrary>true</IsShippingLibrary>

    <PackageId>NBenchmark.Integration.Abstractions</PackageId>
    <Description>Shared abstractions and reusable building blocks for NBenchmark integration packages.</Description>
    <PackageTags>benchmark;performance;integration;abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBenchmark\NBenchmark.csproj"/>
  </ItemGroup>

  <!-- Shared package metadata: authors, repository URL, source link, symbols, XML docs. -->
  <Import Project="../../Release.props"/>

</Project>
