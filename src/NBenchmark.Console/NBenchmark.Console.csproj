<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>NBenchmark.Console</RootNamespace>
        <PackageId>NBenchmark.Console</PackageId>
        <Description>Rich terminal table output for NBenchmark using Spectre.Console.</Description>
        <PackageTags>benchmark;performance;console;spectre</PackageTags>
        <NoWarn>$(NoWarn);CA2255</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NBenchmark\NBenchmark.csproj"/>
    </ItemGroup>

</Project>