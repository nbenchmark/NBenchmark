<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>NBenchmark.Extensions.MSTest</RootNamespace>
        <PackageId>NBenchmark.Extensions.MSTest</PackageId>
        <Description>Run NBenchmark benchmarks with MSTest assertions and configurable performance thresholds.</Description>
        <PackageTags>benchmark;performance;mstest;testing;microbenchmark</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest.TestFramework"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NBenchmark\NBenchmark.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\PerformanceThresholds.cs" Link="Internal\PerformanceThresholds.cs"/>
        <Compile Include="..\Shared\BenchmarkAssert.cs" Link="Internal\BenchmarkAssert.cs"/>
        <Compile Include="..\Shared\RegressionBaseline.cs" Link="Internal\RegressionBaseline.cs"/>
    </ItemGroup>

</Project>
