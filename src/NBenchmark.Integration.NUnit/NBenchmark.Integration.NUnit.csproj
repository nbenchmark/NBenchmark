<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NBenchmark.Integration.NUnit</RootNamespace>

    <IsPackable>true</IsPackable>
    <IsShippingLibrary>true</IsShippingLibrary>

    <PackageId>NBenchmark.Integration.NUnit</PackageId>
    <Description>Run NBenchmark benchmarks as NUnit tests with configurable performance thresholds.</Description>
    <PackageTags>benchmark;performance;nunit;integration;microbenchmark</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBenchmark\NBenchmark.csproj"/>
    <ProjectReference Include="..\NBenchmark.Integration.Abstractions\NBenchmark.Integration.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NBenchmark.Integration.NUnit.Tests"/>
  </ItemGroup>

  <!-- Shared package metadata: authors, repository URL, source link, symbols, XML docs. -->
  <Import Project="../../Release.props"/>

</Project>
