<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NBenchmark.Worker</RootNamespace>

    <!--
      The on-disk name the coordinator looks for. Short and distinctive because it shows up in
      process lists, `ps` output and task managers while a run is in flight - a developer who
      sees an unexpected process should be able to tell what it is.
    -->
    <AssemblyName>nbworker</AssemblyName>

    <!--
      Not packed as its own package: the worker is an implementation detail of NBenchmark and is
      shipped inside NBenchmark's own package, so its version can never skew from the engine's.
    -->
    <IsPackable>false</IsPackable>

    <!--
      A worker built for net8.0 must still start on a machine that only has a newer runtime
      installed, because the coordinator picks the worker whose TFM matches the *target
      assembly*, not whatever runtimes happen to be present.
    -->
    <RollForward>LatestMinor</RollForward>

    <!--
      No apphost. The coordinator launches the worker with `dotnet exec nbworker.dll`, which
      avoids shipping a native launcher per operating system and architecture - three TFMs times
      every RID would be a large payload for no benefit, since a .NET SDK or runtime is
      necessarily present anyway.
    -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBenchmark\NBenchmark.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>

  <!--
    Not a dependency the worker uses: a version floor it has to be able to hand out.

    BenchmarkLoadContext defers System.Diagnostics.DiagnosticSource to the default context so the
    process has one Activity/Meter listener registry rather than two - see the remarks on
    EngineAssemblies for why two is fatal and silent. That deferral only succeeds if the default
    context can satisfy the version the target asks for, and a target referencing the OpenTelemetry
    SDK asks for 10.0.0. Under net10.0 the shared framework already supplies it; under net8.0 and
    net9.0 it does not, so the worker carries the package itself on those two frameworks.

    Raise this in step with the OpenTelemetry SDK's own floor. Too low and the bind falls through
    to the target's copy, which BenchmarkLoadContext traces a warning for.
  -->

</Project>
