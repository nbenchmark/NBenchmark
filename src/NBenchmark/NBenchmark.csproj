<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NBenchmark</RootNamespace>

    <IsPackable>true</IsPackable>
    <IsShippingLibrary>true</IsShippingLibrary>

    <PackageId>NBenchmark</PackageId>
    <Description>NBenchmark is the easiest way to measure the speed of your .NET code. With zero setup and a focus on simplicity, you can go from installation to your first accurate benchmark in seconds - perfect for quick checks and full performance suites alike.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>benchmark;performance;measurement;microbenchmark</PackageTags>

    <!--
      Required by [LibraryImport] in Interop/: the source generator emits pointer-based marshalling
      stubs. It is the AOT- and trim-safe way to declare a native call, so the alternative is not
      "no unsafe code" but a reflective [DllImport] that warns under both. Nothing outside
      Interop/ uses it.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Trim and AOT analysis, on permanently. NBenchmark cannot be trim- or AOT-clean - discovery,
      argument binding and the whole worker protocol are reflective by design - and a consumer who
      set PublishAot=true or PublishTrimmed=true used to get no signal at all about which of those
      would still work. Every reflective member now carries RequiresUnreferencedCode /
      RequiresDynamicCode naming the feature that needs it, so the consumer is told at the call
      site, and the analyzers stay on so a new reflective path is a build break here rather than a
      silent behaviour change in somebody's published app.

      IsTrimmable is the other half: it marks the assembly as safe for the trimmer to reduce, which
      is only true because those annotations exist. The single-file analyzer is deliberately not
      enabled - Assembly.Location is read to locate the worker, which is a separate question from
      trimming and one the worker architecture answers differently.
    -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NBenchmark.Tests"/>
    <InternalsVisibleTo Include="NBenchmark.DependencyInjection"/>
    <InternalsVisibleTo Include="NBenchmark.DependencyInjection.Tests"/>

    <!--
      NBenchmark.Engine, .Workers, .Discovery and .Diagnostics are the measurement engine, not the
      contract. The satellite packages build on them - the integration packages run test methods
      through the same runner the harness uses, and the exporters read the discovery and telemetry
      shapes - which is what internal access is for. Publishing them instead put twenty engine types,
      several under names as common as Outcome and Subject, into every consumer's IntelliSense.
    -->
    <InternalsVisibleTo Include="NBenchmark.Integration.Abstractions"/>
    <InternalsVisibleTo Include="NBenchmark.Integration.xUnit"/>
    <InternalsVisibleTo Include="NBenchmark.Integration.NUnit"/>
    <InternalsVisibleTo Include="NBenchmark.Integration.MSTest"/>
    <InternalsVisibleTo Include="NBenchmark.Integration.xUnit.Tests"/>
    <InternalsVisibleTo Include="NBenchmark.Integration.NUnit.Tests"/>
    <InternalsVisibleTo Include="NBenchmark.Integration.MSTest.Tests"/>
    <InternalsVisibleTo Include="NBenchmark.Reporters.Console"/>
    <InternalsVisibleTo Include="NBenchmark.Reporters.Console.Tests"/>
    <InternalsVisibleTo Include="NBenchmark.Exporters.OpenTelemetry"/>
    <InternalsVisibleTo Include="NBenchmark.Exporters.OpenTelemetry.Tests"/>

    <!--
      The measurement worker. It is a separate process but not a separate design: it runs the
      engine's own measurement loop and the shared DiscoveredGroupExecutor, so an isolated number
      and an in-process number differ only by the runtime configuration the process was started
      with. That requires reaching the engine internals rather than reimplementing them.
      Named for the assembly name, not the project name.
    -->
    <InternalsVisibleTo Include="nbworker"/>

    <!--
      The `dotnet benchmark` global tool. It loads the target assembly into its own process to
      discover benchmarks, so it has the shared-framework problem SharedFrameworkConfig solves about
      itself, and relaunching itself correctly means reaching the same resolver the worker launch
      uses rather than keeping a second copy of the rules. Named for the assembly name.
    -->
    <InternalsVisibleTo Include="nbenchmark-tool"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath=""/>
  </ItemGroup>

  <ItemGroup>
    <!-- Imported automatically by any project that references the package. -->
    <None Include="build/NBenchmark.targets" Pack="true" PackagePath="build/"/>
  </ItemGroup>

  <!--
    The analyzers and their code fixes ship inside this package rather than as a separate opt-in
    NBenchmark.Analyzers package, because a diagnostic nobody installed is a diagnostic nobody
    gets. NB0014 (capturing body), NB0004 (no observable side effect), NB0005 (no-work body) and
    NB0010 (throwaway body) catch exactly the mistakes that produce a confident, wrong number, and
    the author most likely to write a capturing body was the one least likely to have gone looking
    for an optional analyzer package.

    ReferenceOutputAssembly is false because nothing here compiles against Roslyn: the reference
    exists to order the build and to make the assemblies exist by pack time. PrivateAssets keeps
    both projects out of the consumer's dependency graph - they arrive as analyzer content, not as
    a package dependency.
  -->
  <ItemGroup>
    <ProjectReference Include="../NBenchmark.Analyzers/NBenchmark.Analyzers.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="../NBenchmark.CodeFixes/NBenchmark.CodeFixes.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false"/>

    <!--
      Declared as None rather than through TargetsForTfmSpecificContentInPackage (which the worker
      uses) because these are the same two target-framework-independent assemblies for every TFM
      this package builds: collected once in the outer build, they land in analyzers/dotnet/cs
      once, instead of three times over with the same package path.
    -->
    <None Include="../NBenchmark.Analyzers/bin/$(Configuration)/netstandard2.0/NBenchmark.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    <None Include="../NBenchmark.CodeFixes/bin/$(Configuration)/netstandard2.0/NBenchmark.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
  </ItemGroup>

  <!--
    A None item pointing at a file that does not exist is silently dropped by pack, so without this
    the failure mode is a package that restores, builds and reports nothing - the same silence the
    optional package produced, now impossible to notice. Checked in the outer build, before the
    nuspec is generated.
  -->
  <Target Name="_NBenchmarkVerifyAnalyzers" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../NBenchmark.Analyzers/bin/$(Configuration)/netstandard2.0/NBenchmark.Analyzers.dll')"
           Text="NBenchmark.Analyzers.dll was not built for $(Configuration). Packing without it would ship a package whose benchmark-authoring diagnostics silently never run."/>

    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../NBenchmark.CodeFixes/bin/$(Configuration)/netstandard2.0/NBenchmark.CodeFixes.dll')"
           Text="NBenchmark.CodeFixes.dll was not built for $(Configuration). Packing without it would ship diagnostics with no code fixes attached."/>
  </Target>

  <!--
    Packs the measurement worker under tools/<tfm>/, so its version can never skew from the engine's
    - which matters, because the worker unifies NBenchmark from its own load context rather than
    loading the consumer's copy, and a skew would measure against different engine code than the
    user compiled against with no other symptom.

    The worker is built here with the MSBuild task rather than declared as a ProjectReference,
    because the worker references this project: a reference back would close a cycle. This target
    runs once per target framework, so each pass builds and collects the matching worker.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);_NBenchmarkPackWorker
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    Build the worker into the tools folder unless the caller pinned NoBuild (for example, the
    release workflow packs with the no-build flag after building the solution). Under NoBuild the
    worker was already built by the preceding solution build, so re-invoking its Build target
    would trip NETSDK1085 ("NoBuild=true but Build was invoked"). The Error checks below still
    verify the output exists, so a genuinely missing worker still fails the pack instead of
    shipping an empty tools folder.
  -->
  <Target Name="_NBenchmarkPackWorker">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../NBenchmark.Worker/NBenchmark.Worker.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             Condition="'$(NoBuild)' != 'true'"/>

    <PropertyGroup>
      <_NBenchmarkWorkerOutput>$(MSBuildThisFileDirectory)../NBenchmark.Worker/bin/$(Configuration)/$(TargetFramework)/</_NBenchmarkWorkerOutput>
    </PropertyGroup>

    <Error Condition="!Exists('$(_NBenchmarkWorkerOutput)nbworker.dll')"
           Text="The measurement worker was not built for $(TargetFramework). Packing without it would ship a package whose benchmarks silently fall back to in-process measurement."/>

    <!--
      The whole worker output, not just nbworker's own three files. nbworker.deps.json lists
      NBenchmark as a dependency resolved relative to nbworker.dll's own directory, so a tools
      folder holding only nbworker would fail to start with a host-level FileNotFoundException
      before reaching any of our code - and the coordinator would report an unexplained dead
      worker and fall back to in-process measurement for every package consumer.

      Globbed rather than enumerated so a future dependency cannot reintroduce that failure by
      being forgotten here. Symbols are excluded; everything the host resolver reads is not.
    -->
    <ItemGroup>
      <_NBenchmarkWorkerPayload Include="$(_NBenchmarkWorkerOutput)**\*.dll;$(_NBenchmarkWorkerOutput)**\*.json"/>

      <TfmSpecificPackageFile Include="@(_NBenchmarkWorkerPayload)">
        <PackagePath>tools/$(TargetFramework)/%(RecursiveDir)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>

    <Error Condition="!Exists('$(_NBenchmarkWorkerOutput)NBenchmark.dll')"
           Text="The measurement worker's copy of NBenchmark.dll is missing from '$(_NBenchmarkWorkerOutput)'. nbworker cannot start without it, so packing would ship a worker that dies before its handshake."/>
  </Target>

  <!-- Shared package metadata: authors, repository URL, source link, symbols, XML docs. -->
  <Import Project="../../Release.props"/>

</Project>
