<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NBenchmark.Integration.xUnit</RootNamespace>
    <PackageId>NBenchmark.Integration.xUnit</PackageId>
    <Description>Run NBenchmark benchmarks as xUnit tests with configurable performance thresholds.</Description>
    <PackageTags>benchmark;performance;xunit;integration;microbenchmark</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.core"/>
    <PackageReference Include="xunit.extensibility.execution"/>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NBenchmark\NBenchmark.csproj"/>
    <ProjectReference Include="..\NBenchmark.Integration.Abstractions\NBenchmark.Integration.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NBenchmark.Integration.xUnit.Tests"/>
  </ItemGroup>

</Project>
