<Project>

  <!--
    In-repo equivalent of the `build/NBenchmark.targets` that ships in the package.

    A package consumer gets the measurement worker copied into its output automatically. A project
    inside this repository references NBenchmark by ProjectReference instead, which does not import
    the package's build targets, so worker deployment has to be wired here.

    Rather than copying files - which would race the worker's own build on a clean clone, because
    item globs are evaluated before referenced projects are built - the worker's output directory is
    baked into the assembly as metadata that WorkerLocator reads at run time. Same mechanism the
    isolation-fixture tests already use, and immune to build ordering.

    Opt in with <NBenchmarkUseWorker>true</NBenchmarkUseWorker>.
  -->

  <ItemGroup Condition="'$(NBenchmarkUseWorker)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/NBenchmark.Worker/NBenchmark.Worker.csproj"
                     ReferenceOutputAssembly="false"/>

    <AssemblyMetadata Include="NBenchmarkWorkerDirectory"
                      Value="$(MSBuildThisFileDirectory)src/NBenchmark.Worker/bin/$(Configuration)/$(TargetFramework)/"/>
  </ItemGroup>

  <!--
    Only in the inner, per-framework build: in a multi-targeting project's outer pass both
    $(TargetFramework) and $(OutDir) are unset, so the glob below would match every framework's
    worker output at once and land it in the project directory rather than in bin.

    Copies the worker into an `nbworker` subdirectory of the output, which is exactly the layout the
    packaged build targets produce for a consumer. It matters for a test project specifically: under
    a test host the entry assembly is the test runner, so the AssemblyMetadata above - which sits on
    the test project's own assembly - is never consulted, and only the output-relative location is
    found. Without this, an in-repo test would silently exercise the in-process fallback while
    appearing to prove isolation.
  -->
  <Target Name="NBenchmarkCopyWorkerToOutput"
          Condition="'$(NBenchmarkUseWorker)' == 'true' AND '$(TargetFramework)' != ''"
          AfterTargets="Build">
    <ItemGroup>
      <NBenchmarkWorkerFile Include="$(MSBuildThisFileDirectory)src/NBenchmark.Worker/bin/$(Configuration)/$(TargetFramework)/**/*"/>
    </ItemGroup>

    <Copy SourceFiles="@(NBenchmarkWorkerFile)"
          DestinationFolder="$(OutDir)nbworker/%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(NBenchmarkWorkerFile)' != ''"/>
  </Target>

  <!--
    Guards the deliberately-low Roslyn pins declared in Directory.Build.props. Two failure modes,
    both of which are silent without this: a package updater rewrites VersionOverride to a literal
    current version - Rider's did, in the update that produced this target - or the pin properties
    stop resolving and VersionOverride expands to empty, at which point central package management
    quietly supplies the much newer central version instead.

    Either one produces analyzer assemblies built against a Roslyn newer than the oldest supported
    SDK can load, and an analyzer that cannot be loaded does not fail a build - it just never
    reports anything. Nothing downstream would notice, so the check has to be here.

    Hooked before CollectPackageReferences as well as Build, so that `dotnet restore` on its own
    fails too: by build time NuGet has already resolved the wrong version into project.assets.json.
  -->
  <Target Name="VerifyPinnedRoslynVersions"
          Condition="'$(NBenchmarkPinsRoslyn)' == 'true'"
          BeforeTargets="CollectPackageReferences;Build">

    <Error Condition="'$(NBenchmarkRoslynPin)' == '' OR '$(NBenchmarkRoslynAnalyzersPin)' == ''"
           Code="NBPIN001"
           Text="The Roslyn pin properties are not set. $(MSBuildProjectName) pins Roslyn low on purpose and resolves its VersionOverride from NBenchmarkRoslynPin / NBenchmarkRoslynAnalyzersPin, which Directory.Build.props is meant to declare. Empty here means central package management would silently substitute the central Microsoft.CodeAnalysis version."/>

    <Error Condition="'%(PackageReference.NBenchmarkPinnedVersion)' != '' AND '%(PackageReference.VersionOverride)' != '%(PackageReference.NBenchmarkPinnedVersion)'"
           Code="NBPIN002"
           Text="%(PackageReference.Identity) is pinned at %(PackageReference.NBenchmarkPinnedVersion) in $(MSBuildProjectName) but VersionOverride says '%(PackageReference.VersionOverride)'. This pin is a floor on the SDK that can load the shipped analyzers - read the comment above the PackageReference items in src/NBenchmark.Analyzers/NBenchmark.Analyzers.csproj before changing it. If the raise is intended, change the pin property in Directory.Build.props rather than hardcoding a version here."/>
  </Target>

  <!--
    Set here rather than in Directory.Build.props: that file is imported before the csproj sets
    IsShippingLibrary, and MSBuild evaluates properties in import order, so a condition on it
    there is always false. Item conditions are evaluated in a later pass, which is why the
    AdditionalFiles in Directory.Build.props do work.
  -->
  <PropertyGroup Condition="'$(IsShippingLibrary)' == 'true'">
    <!--
      RS0026 and RS0027 police overload sets where more than one member has optional parameters,
      because adding a parameter to one of them later is a source-breaking change. NBenchmark is
      built out of exactly that shape - `Benchmark.Run`, `BenchmarkSuite.Add` and their async and
      generic siblings are 148 such overloads, each ending in the same optional
      options/name/progress/cancellation tail - and collapsing them would mean spelling out
      `MeasurementOptions` at every call site. The manifest is what protects compatibility here,
      and the manifest is reviewed.
    -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

</Project>
